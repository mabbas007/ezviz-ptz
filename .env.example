# Copy to .env and edit:  cp .env.example .env
#
# Only the values marked REQUIRED have to be set; everything else falls back to
# a default in frigate-onvif-go/internal/config. The full reference, including the
# advanced variables that are not listed here, is in frigate-onvif/README.md.

# --- camera (Hikvision SDK on port 8000, not RTSP 554 / HTTP 80) -----------
# REQUIRED: camera LAN address.
CAMERA_HOST=192.168.1.10
CAMERA_PORT=8000
CAMERA_USER=admin
# REQUIRED: the EZVIZ "verification code" printed on the camera label, not the
# EZVIZ account password.
CAMERA_PASSWORD=CHANGE_ME

# --- ONVIF server (what Frigate connects to) -------------------------------
# Each extra camera needs its own ONVIF_PORT and its own container.
ONVIF_PORT=8081
# Leave both empty to accept any client (not recommended on a shared LAN).
ONVIF_USER=frigate
ONVIF_PASSWORD=CHANGE_ME
# Only needed behind NAT / a reverse proxy: host used in the XAddrs URLs.
# ONVIF_ADVERTISE_HOST=192.168.1.50

# --- stream advertised to ONVIF clients (Frigate Add Camera) --------------
# GetStreamUri composes the URL from these values. Leave RTSP_URL empty to use
# the auto-built one; set it only to override the whole URL.
# RTSP_URL=rtsp://admin:CHANGE_ME@192.168.1.10:554/H.264
RTSP_PORT=554
# EZVIZ/Hikvision IPCs use /H.264 and /H.265. Other firmware may need
# /Streaming/Channels/101 (and an explicit profile query string).
# When empty, the path follows VIDEO_ENCODING (H264 -> /H.264, H265 -> /H.265).
# RTSP_PATH=/H.264
# Host used in the advertised URL. Defaults to CAMERA_HOST; set it when Frigate
# reaches the camera through a different address.
# RTSP_ADVERTISE_HOST=192.168.1.10
# The stream normally uses CAMERA_USER / CAMERA_PASSWORD. Override only when
# the camera has a separate RTSP account.
# RTSP_USER=admin
# RTSP_PASSWORD=CHANGE_ME
# Embed camera credentials in GetStreamUri. This makes Frigate's Add Camera
# wizard work with empty ONVIF credentials; set false to return a clean URL and
# inject the camera credentials as the ONVIF credentials instead.
RTSP_INCLUDE_CREDENTIALS=true

# --- media profile fallback metadata --------------------------------------
# Used until the SDK reports the real encoder settings (or when the firmware
# rejects the config read). H264 | H265 | JPEG | MPEG4 and kbps.
VIDEO_ENCODING=H264
VIDEO_BITRATE=4096
# VIDEO_WIDTH=1920
# VIDEO_HEIGHT=1080
# VIDEO_FPS=25

# --- movement tuning -------------------------------------------------------
# SDK speed 1-7 used when Frigate sends no speed.
PTZ_SPEED=4
# Seconds for one full field of view at PTZ_SPEED. Calibrate per camera:
# too small -> autotracking lags, too large -> it oscillates.
PAN_SECONDS_PER_FOV=0.9
TILT_SECONDS_PER_FOV=0.7
# The EZVIZ C8C and TY1 reject zoom commands (NET_DVR_NETWORK_ERRORDATA).
PTZ_ZOOM=false

# --- housekeeping ----------------------------------------------------------
LOG_LEVEL=INFO
